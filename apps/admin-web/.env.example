NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Solo servidor — crear usuarios auth desde el panel (opcional; ver nota abajo)
# En el dashboard de Supabase puede aparecer como "secret key" (legacy: service_role)
SUPABASE_SERVICE_ROLE_KEY=

# La secret key solo hace falta para POST /api/usuarios (crear cuentas auth).

# En Supabase Auth → URL Configuration, agregá:
#   http://localhost:3001/auth/callback
#   https://TU_DOMINIO/auth/callback
# Y activá el provider Google.
