    "web": "pnpm exec expo start --web",
    "prebuild": "pnpm exec expo prebuild",
    "prebuild:clean": "pnpm exec expo prebuild --clean",
    "eas": "pnpm dlx eas-cli",
    "supabase": "supabase",
    "supabase:functions:deploy:auto-completar": "supabase functions deploy auto-completar-reservas --no-verify-jwt",
    "generate:lottie": "node scripts/generate-lottie-assets.mjs"
  },
