{
  "expo": {
    "name": "armemosla",
    "slug": "armemosla",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icono.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/logopng.png",
      "resizeMode": "contain",
      "backgroundColor": "#00000000"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "scheme": "armemosla",
    "plugins": [
      "expo-router",
      "expo-splash-screen",
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.dummy"
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/icono.png",
          "color": "#000000",
          "sounds": []
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "Permitir acceso al micrófono para grabar audio."
        }
      ],
      "expo-video",
      "expo-dev-client",
      [
        "expo-maps",
        {
          "googleMapsApiKey": "AIzaSyDc6OMuPyp8UBaYHq2HaprhLyVVHiF9LZU"
        }
      ]
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.armemosla.app",
      "googleServicesFile": "./GoogleService-Info.plist",
      "infoPlist": {
        "UIBackgroundModes": [
          "audio",
          "remote-notification"
        ],
        "NSLocationWhenInUseUsageDescription": "Esta app necesita acceso a tu ubicación para seleccionar la dirección del complejo deportivo en el mapa.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "Esta app necesita acceso a tu ubicación para seleccionar la dirección del complejo deportivo en el mapa."
      },
      "config": {
        "googleSignIn": {
          "reservedClientId": ""
        }
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/icono.png",
        "backgroundColor": "#000000",
        "resizeMode": "contain"
      },
      "package": "com.armemosla.app",
      "googleServicesFile": "./google-services.json",
      "permissions": [
        "INTERNET",
        "ACCESS_NETWORK_STATE",
        "CAMERA",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE",
        "RECORD_AUDIO",
        "NOTIFICATIONS",
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ],
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyDc6OMuPyp8UBaYHq2HaprhLyVVHiF9LZU"
        }
      }
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "extra": {
      "eas": {
        "projectId": "845ee3c3-eebd-4ae8-a15a-a2060ccc3d77"
      },
      "supabaseUrl": "",
      "supabaseAnonKey": "",
      "googleIosClientId": "",
      "googleAndroidClientId": "",
      "googleWebClientId": ""
    },
    "owner": "ludwinb"
  }
}
